{
  "manifest_version": 3,
  "name": "Doceru Ebook Extractor",
  "version": "1.1",
  "description": "Encontra o arquivo PDF, EPUB ou MOBI de um documento do Doceru.com para copiar o link ou baixar com o nome do livro.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://doceru.com/*",
        "https://*.doceru.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
